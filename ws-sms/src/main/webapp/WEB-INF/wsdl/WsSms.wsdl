        <soap12:body use="literal" parts="out"/>
      </output>
      <fault name="falla">
        <soap12:fault name="falla" use="literal"/>
      </fault>
    </operation>
    <operation name="recibeSMS">
      <soap12:operation style="document" soapAction="http://soa.osinergmin.gob.pe/schema/wssms/recibeSMS"/>
      <input>
        <soap12:body use="literal" parts="in"/>
        <soap12:header message="wssms:RecibeSMSRequestMsg" use="literal" part="consumidor"/>
