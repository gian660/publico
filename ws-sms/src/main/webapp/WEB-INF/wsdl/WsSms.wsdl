      <output>
        <soap12:body use="literal" parts="out"/>
      </output>
      <fault name="falla">
        <soap12:fault name="falla" use="literal"/>
      </fault>
    </operation>
  </binding> -->
  <message name="RecibeSMSRequestMsg">
    <part name="in" element="wssms:recibeSMSReqParamTYPE"/>
    <part name="consumidor" element="cons:consumidor"/>
  </message>
  <message name="RecibeSMSResponseMsg">
    <part name="out" element="wssms:recibeSMSRespParamTYPE"/>
  </message>
  <service name="WsSMSService">
    <port name="WsSMSPortSOAP11" binding="wssms:WsSMSPortSOAP11Binding">
      <soap:address location="http://domain/ws-sms/services"/>
    </port>
    <!-- <port name="WsSMSPortSOAP12" binding="wssms:WsSMSPortSOAP12Binding">
      <soap12:address location="http://domain/ws-sms/services"/>
    </port> -->
  </service>
  <service name="WsSMSService11">
    <port name="WsSMSPortSOAP11" binding="wssms:WsSMSPortSOAP11Binding">
      <soap:address location="http://domain/ws-sms/services"/>
    </port>
    <!-- <port name="WsSMSPortSOAP12" binding="wssms:WsSMSPortSOAP12Binding">
      <soap12:address location="http://domain/ws-sms/services"/>
    </port> -->
  </service>
</definitions>